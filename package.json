{
  "name": "impactaqiqah",
  "version": "0.1.0",
  "private": true,
  "description": "ImpactAqiqah — Operations Command Center untuk Aqiqah, Qurban, dan Sedekah Daging (Zakat Sukses).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint",
    "db:bootstrap": "node --env-file=.env.local scripts/dev-bootstrap.mjs",
    "db:migrations": "node scripts/apply-migrations.mjs --list",
    "db:baseline": "node --env-file=.env.local scripts/apply-migrations.mjs --baseline",
    "db:apply": "node --env-file=.env.local scripts/apply-migrations.mjs",
    "e2e": "node --env-file=.env.local scripts/e2e-checkout.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.45.0",
    "marked": "^18.0.5",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pg": "^8.22.0",
    "sharp": "^0.35.1",
    "supabase": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
