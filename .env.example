# ImpactAqiqah — contoh environment variables
# Salin ke .env.local (Next.js) / set di Vercel & n8n. JANGAN commit nilai asli.
# Acuan: docs/20_SECURITY_CHECKLIST.md, docs/22_DEPLOYMENT_PLAN.md

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (JANGAN diekspos ke klien)
SUPABASE_SERVICE_ROLE_KEY=
# Koneksi Postgres langsung untuk `npm run db:apply` (otomasi migrasi).
# Pakai Session pooler URI: Supabase → Settings → Database → Connection string → URI (port 5432).
# Contoh: postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Google Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- n8n (automation) ---
N8N_WEBHOOK_SECRET=

# --- Email / SMTP (dipakai n8n) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- AI Layer (Phase 2) — fallback berurutan: Gemini → OpenRouter → Anthropic ---
# Gemini (utama). Bila satu key error/limit, otomatis geser ke key berikutnya.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# 2.5 Flash: GA stabil, cepat, murah, hemat token.
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter (cadangan kedua, OpenAI-compatible)
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
# GPT-4o-mini: provider beda dari Gemini (diversifikasi anti-down), reliabel & murah.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Model cadangan di dalam OpenRouter (pisah koma) — routing fallback bawaan OpenRouter.
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct
# Anthropic (PILIHAN TERAKHIR) — Haiku 4.5: termurah & tercepat, hemat token.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WA_NUMBER=6281234567890

# --- Chatbot AI (docs/26) ---
# Nomor admin tujuan handoff WhatsApp (kosong = pakai NEXT_PUBLIC_WA_NUMBER). Bisa dioverride di Super Admin.
ADMIN_WHATSAPP_NUMBER=
# Hard-off: set "false" untuk menyembunyikan widget di seluruh situs (default tampil bila config DB enabled).
NEXT_PUBLIC_CHATBOT_ENABLED=true
NEXT_PUBLIC_CHATBOT_NAME=ImpactAqiqah AI Assistant

# --- Brevo (email transaksional + marketing) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@impactaqiqah.id
BREVO_SENDER_NAME=ImpactAqiqah
BREVO_LIST_ID=

# --- Tawk.to (live chat) ---
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# --- iPaymu (payment gateway) ---
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_MODE=sandbox
IPAYMU_NOTIFY_URL=
# (kosongkan IPAYMU_NOTIFY_URL untuk pakai default {APP_URL}/api/webhooks/ipaymu)

# --- Telegram admin notifications (opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
